 {
  "name": "file.restoreVersion",
  "risk_class": "write.reversible",
  "verify": "GET /drives/{driveId}/items/{itemId}/versions: a new current version with the chosen version's size",
  "compensate": "restoreVersion to the version that was current before (output.previousVersionId); the overwritten version stays in the history either way",
  "params": {
   "additionalProperties": false,
   "properties": {
    "driveId": {
     "description": "A drive_id from files.search",
     "pattern": "^[A-Za-z0-9!_-]+$",
     "title": "Driveid",
     "type": "string"
    },
    "itemId": {
     "description": "An item_id from files.search",
     "pattern": "^[A-Za-z0-9!_-]+$",
     "title": "Itemid",
     "type": "string"
    },
    "versionId": {
     "description": "A version id from files.versions, e.g. '2.0'",
     "pattern": "^\\d+\\.\\d+$",
     "title": "Versionid",
     "type": "string"
    },
    "fileName": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "The file's name, for the approval card only",
     "title": "Filename"
    }
   },
   "required": [
    "driveId",
    "itemId",
    "versionId"
   ],
   "title": "FileRestoreVersionParams",
   "type": "object"
  },
