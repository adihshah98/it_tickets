 {
  "name": "link.sendOneTime",
  "risk_class": "none",
  "verify": "link record exists and is unviewed",
  "compensate": "expire the link",
  "params": {
   "additionalProperties": false,
   "properties": {
    "to": {
     "pattern": "^[^@\\s]+@[^@\\s]+$",
     "title": "To",
     "type": "string"
    },
    "userId": {
     "description": "The user the credentials are for",
     "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|\\$ref:[A-Za-z0-9_-]+\\.output\\.id)$",
     "title": "Userid",
     "type": "string"
    },
    "tap": {
     "anyOf": [
      {
       "description": "'$ref:<tap.create step id>.output.tap'. The TAP value itself is never in a plan",
       "pattern": "^\\$ref:[A-Za-z0-9_-]+\\.output\\.tap$",
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Omit to use this user's tap.create step",
     "title": "Tap"
    },
    "includes": {
     "default": [],
     "items": {
      "enum": [
       "email_access_steps",
       "outlook_mobile_app_tip",
       "file_share_note"
      ],
      "type": "string"
     },
     "title": "Includes",
     "type": "array"
    },
    "note": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Plain text shown with the link. Never put a TAP or password here",
     "title": "Note"
    }
   },
   "required": [
    "to",
    "userId"
   ],
   "title": "LinkSendParams",
   "type": "object"
  },
  "console": false
 },
