[
 {
  "name": "user.create",
  "risk_class": "write.reversible",
  "verify": "GET /users/{id}: exists, usageLocation and the created properties match",
  "compensate": "DELETE /users/{id} (soft delete, restorable for 30 days)",
  "params": {
   "additionalProperties": false,
   "properties": {
    "displayName": {
     "title": "Displayname",
     "type": "string"
    },
    "givenName": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Givenname"
    },
    "surname": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Surname"
    },
    "userPrincipalName": {
     "pattern": "^[^@\\s]+@[^@\\s]+$",
     "title": "Userprincipalname",
     "type": "string"
    },
    "mailNickname": {
     "title": "Mailnickname",
     "type": "string"
    },
    "department": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Department"
    },
    "jobTitle": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Jobtitle"
    },
    "usageLocation": {
     "description": "Two-letter country code, from client facts",
     "pattern": "^[A-Z]{2}$",
     "title": "Usagelocation",
     "type": "string"
    },
    "accountEnabled": {
     "default": true,
     "title": "Accountenabled",
     "type": "boolean"
    }
   },
   "required": [
    "displayName",
    "userPrincipalName",
    "mailNickname",
    "usageLocation"
   ],
   "title": "UserCreateParams",
   "type": "object"
  },
  "console": true
 },
